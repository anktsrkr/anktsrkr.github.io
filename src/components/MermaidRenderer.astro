<script>
  const renderMermaidBlocks = async () => {
    const mermaidBlocks = Array.from(
      document.querySelectorAll('.article-content pre[data-language="mermaid"]')
    );

    if (mermaidBlocks.length === 0) {
      return;
    }

    const diagrams = mermaidBlocks.map((block, index) => {
      const code = block.querySelector('code');
      const source = code?.textContent?.trim();

      if (!source) {
        return null;
      }

      const frame = document.createElement('div');
      frame.className = 'mermaid-frame';
      frame.setAttribute('aria-live', 'polite');
      frame.textContent = 'Rendering diagram...';
      block.replaceWith(frame);

      return {
        frame,
        source,
        id: `mermaid-diagram-${index + 1}`
      };
    }).filter((diagram) => diagram !== null);

    if (diagrams.length === 0) {
      return;
    }

    const { default: mermaid } = await import('mermaid/dist/mermaid.esm.mjs');

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      htmlLabels: true,
      theme: 'base',
      themeVariables: {
        background: '#fffdf8',
        primaryColor: '#d9f8ff',
        primaryTextColor: '#171923',
        primaryBorderColor: '#00b8d9',
        lineColor: '#3654d4',
        secondaryColor: '#fff2c7',
        tertiaryColor: '#f8dde9',
        noteBkgColor: '#fff2c7',
        noteTextColor: '#171923',
        noteBorderColor: '#f2a900',
        actorBkg: '#fffdf8',
        actorBorder: '#232832',
        actorTextColor: '#171923',
        signalColor: '#3654d4',
        signalTextColor: '#171923',
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif'
      }
    });

    for (const diagram of diagrams) {
      try {
        const rendered = await mermaid.render(diagram.id, diagram.source);
        diagram.frame.removeAttribute('aria-live');
        diagram.frame.innerHTML = rendered.svg;
        rendered.bindFunctions?.(diagram.frame);
      } catch (error) {
        console.error('Mermaid render failed', error);
        diagram.frame.classList.add('mermaid-frame-error');
        diagram.frame.innerHTML = '';

        const message = document.createElement('p');
        message.textContent = 'Unable to render this Mermaid diagram.';

        const fallback = document.createElement('pre');
        fallback.textContent = diagram.source;

        diagram.frame.append(message, fallback);
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidBlocks, { once: true });
  } else {
    renderMermaidBlocks();
  }
</script>
