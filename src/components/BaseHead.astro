---
import { getShareImage, site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  title = site.fullTitle,
  description = site.description,
  image,
  canonical = '/',
  type = 'website'
} = Astro.props;

const pageTitle = title === site.fullTitle ? title : `${title} | ${site.title}`;
const canonicalUrl = new URL(canonical, site.url).toString();
const socialImage = new URL(getShareImage(image), site.url).toString();
const gaId = site.googleAnalyticsId;
const adsenseClient = site.adsenseClient;
const googleAnalyticsScript = gaId
  ? `
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){window.dataLayer.push(arguments);}

      var gaDebugStorageKey = 'ga_debug_mode';
      var gaDebugParam = new URLSearchParams(window.location.search).get('ga_debug');
      var gaDebugMode = false;
      function getGaDebugStorage() {
        try {
          return window.localStorage.getItem(gaDebugStorageKey);
        } catch (_) {
          return null;
        }
      }
      function setGaDebugStorage(value) {
        try {
          if (value) {
            window.localStorage.setItem(gaDebugStorageKey, value);
          } else {
            window.localStorage.removeItem(gaDebugStorageKey);
          }
        } catch (_) {
          gaDebugMode = value === '1';
        }
      }

      if (gaDebugParam === '1') {
        setGaDebugStorage('1');
      } else if (gaDebugParam === '0') {
        setGaDebugStorage(null);
      }

      var gaConfig = {};
      if (gaDebugMode || getGaDebugStorage() === '1') {
        gaDebugMode = true;
        window.__gaDebugMode = true;
        gaConfig.debug_mode = true;
      }

      window.gtag('js', new Date());
      window.gtag('config', ${JSON.stringify(gaId)}, gaConfig);
      if (gaDebugMode) {
        window.gtag('event', 'debug_ping', {
          debug_mode: true,
          event_category: 'diagnostics',
          page_location: window.location.href
        });
      }
    `
  : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={site.fullTitle} href="/index.xml" />
<link rel="manifest" href="/manifest.json" />
<link rel="icon" href="/appicons/favicon-196x196.png" />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@ankt_srkr" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline set:html={googleAnalyticsScript}></script>
  </>
)}
{adsenseClient && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
    crossorigin="anonymous"
  ></script>
)}
