---
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTerms, getPublishedPosts, paginateItems, postsForTerm } from '../../lib/content';

export async function getStaticPaths() {
  const pageSize = 9;
  const posts = await getPublishedPosts();
  return getAllTerms(posts, 'tags').map((tag) => {
    const termPosts = postsForTerm(posts, 'tags', tag.slug);
    const pagination = paginateItems(termPosts, 1, pageSize);

    return {
      params: { tag: tag.slug },
      props: { pagePosts: pagination.items, pagination, posts: termPosts, tag }
    };
  });
}

const { pagePosts, pagination, posts, tag } = Astro.props;
---

<BaseLayout title={`#${tag.name}`} description={`Posts tagged ${tag.name}`} canonical={`/tags/${tag.slug}/`}>
  <main class="listing-layout">
    <header class="page-hero">
      <p class="eyebrow">Tag</p>
      <h1 class="page-title">#{tag.name}</h1>
      <p class="page-intro">{tag.count} posts with this tag.</p>
    </header>
    <div class="listing-grid">
      <aside class="directory-rail" aria-label="Tag tools">
        <div class="rail-panel">
          <span class="aside-label">Reading queue</span>
          <strong>{posts.length} notes</strong>
        </div>
        <div class="rail-panel">
          <a class="button-link" href="/tags/">All tags</a>
          <a class="button-link" href="/archives/">Archives</a>
        </div>
      </aside>
      <div class="listing-main">
        <div class="post-grid post-grid-compact">
          {pagePosts.map((post) => <PostCard post={post} />)}
        </div>
        <Pagination
          basePath={`/tags/${tag.slug}/`}
          currentPage={pagination.currentPage}
          totalPages={pagination.totalPages}
          label={`${tag.name} pages`}
        />
      </div>
    </div>
  </main>
</BaseLayout>
