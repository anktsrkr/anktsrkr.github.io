---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArchiveGroups, getPublishedPosts } from '../../lib/content';
import { formatDate, postUrlFromId } from '../../lib/site';

const posts = await getPublishedPosts();
const groups = getArchiveGroups(posts);
---

<BaseLayout title="Archives" description="Chronological archive of posts" canonical="/archives/">
  <main>
    <header class="article-hero">
      <p class="eyebrow">Chronology</p>
      <h1 class="page-title">Archives</h1>
      <p class="page-intro">Every published technical note, newest first.</p>
    </header>
    <div class="archive-list">
      {groups.map((group) => (
        <section class="archive-year">
          <h2>{group.label}</h2>
          {group.posts.map((post) => (
            <a href={postUrlFromId(post.id)}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {' - '}
              {post.data.title}
            </a>
          ))}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
