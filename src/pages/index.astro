---
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPosts, getPublishedPosts, paginateItems } from '../lib/content';
import { site } from '../lib/site';

const PAGE_SIZE = 9;
const FEATURED_LIMIT = 4;
const posts = await getPublishedPosts();
const featuredPosts = getFeaturedPosts(posts, FEATURED_LIMIT);
const pagination = paginateItems(posts, 1, PAGE_SIZE);
---

<BaseLayout title={site.fullTitle} description={site.description} canonical="/">
  <main class="home-layout">
    <section class="content-section content-section-first" aria-labelledby="featured-heading">
      <div class="section-header">
        <h2 id="featured-heading">Featured Posts</h2>
        <a href="/archives/">All posts</a>
      </div>
      <div class="featured-list">
        {featuredPosts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
      </div>
    </section>

    <section class="content-section recent-section" aria-labelledby="recent-heading">
      <div class="section-header">
        <h2 id="recent-heading">Recent Posts</h2>
        <a href="/index.xml">RSS</a>
      </div>
      <div class="post-grid post-grid-compact">
        {pagination.items.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination
        basePath="/"
        currentPage={pagination.currentPage}
        totalPages={pagination.totalPages}
        label="Recent post pages"
      />
    </section>
  </main>
</BaseLayout>
