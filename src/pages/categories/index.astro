---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTerms, getPublishedPosts } from '../../lib/content';
import { termUrl } from '../../lib/site';

const posts = await getPublishedPosts();
const categories = getAllTerms(posts, 'categories');
const topCategories = [...categories].sort((a, b) => b.count - a.count).slice(0, 5);
---

<BaseLayout title="Categories" description="Browse posts by category" canonical="/categories/">
  <main class="directory-layout">
    <header class="page-hero">
      <p class="eyebrow">Categories</p>
      <h1 class="page-title">Categories</h1>
      <p class="page-intro">Follow the major themes across Azure, .NET, testing, automation, and applied AI.</p>
    </header>
    <div class="directory-grid">
      <aside class="directory-rail" aria-label="Category summary">
        <div class="rail-panel">
          <span class="aside-label">Coverage</span>
          <strong>{posts.length} notes across {categories.length} categories</strong>
        </div>
        <div class="rail-panel">
          <span class="aside-label">Most active</span>
          <div class="mini-list">
            {topCategories.map((category) => (
              <a href={termUrl('categories', category.name)}>
                <span>{category.name}</span>
                <strong>{category.count}</strong>
              </a>
            ))}
          </div>
        </div>
      </aside>
      <div class="terms-grid terms-grid-featured">
        {categories.map((category) => (
          <a class="term-pill" href={termUrl('categories', category.name)}>
            <span>{category.name}</span>
            <strong>{category.count}</strong>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
