---
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, paginateItems } from '../../lib/content';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const pageSize = 9;
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / pageSize);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    const pagination = paginateItems(posts, pageNumber, pageSize);

    return {
      params: { page: String(pageNumber) },
      props: { pagination }
    };
  });
}

const { pagination } = Astro.props;
---

<BaseLayout
  title={`${site.title} - Posts Page ${pagination.currentPage}`}
  description={`${site.description}, posts page ${pagination.currentPage}`}
  canonical={`/page/${pagination.currentPage}/`}
>
  <main class="home-layout">
    <section class="content-section content-section-first recent-section" aria-labelledby="recent-heading">
      <div class="section-header">
        <h1 id="recent-heading">Recent Posts</h1>
        <a href="/index.xml">RSS</a>
      </div>
      <div class="post-grid post-grid-compact">
        {pagination.items.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination
        basePath="/"
        currentPage={pagination.currentPage}
        totalPages={pagination.totalPages}
        label="Recent post pages"
      />
    </section>
  </main>
</BaseLayout>
