---
import Disqus from '../components/Disqus.astro';
import CodeCopy from '../components/CodeCopy.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import PostSeriesNav from '../components/PostSeriesNav.astro';
import ShareLinks from '../components/ShareLinks.astro';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/content';
import { getPostSeries } from '../lib/series';
import { formatDate, getShareImage, postUrlFromId, site, termUrl } from '../lib/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: Post;
  headings: Heading[];
  hasMermaid?: boolean;
}

const { post, headings, hasMermaid = false } = Astro.props;
const url = postUrlFromId(post.id);
const absoluteUrl = new URL(url, site.url).toString();
const image = getShareImage(post.data.shareImage, post.data.thumbnailImage);
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
const tags = post.data.tags ?? [];
const hasToc = toc.length > 0;
const hasDescription = post.data.description.trim().toLowerCase() !== post.data.title.trim().toLowerCase();
const series = getPostSeries(post.data.series);
const tocSections = toc.reduce<{ heading: Heading; children: Heading[] }[]>((sections, heading) => {
  if (heading.depth === 2 || sections.length === 0) {
    sections.push({ heading, children: [] });
    return sections;
  }

  sections[sections.length - 1].children.push(heading);
  return sections;
}, []);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  canonical={url}
  type="article"
>
  <article class="article-shell">
    <header class="article-hero">
      <div class="article-kicker">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{post.data.categories?.[0] ?? 'Technical Notes'}</span>
      </div>
      <h1>{post.data.title}</h1>
      {hasDescription && <p>{post.data.description}</p>}
      <div class="article-tags">
        {post.data.categories?.map((category) => <a href={termUrl('categories', category)}>{category}</a>)}
      </div>
    </header>

    <div class="article-grid">
      <div class="article-content">
        {hasToc && (
          <details class="toc-inline">
            <summary>On this page</summary>
            <nav class="toc-sections" aria-label="Table of contents">
              {tocSections.map((section) => (
                <div class="toc-section">
                  <a class="toc-section-link" href={`#${section.heading.slug}`}>{section.heading.text}</a>
                  {section.children.length > 0 && (
                    <div class="toc-sublinks">
                      {section.children.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
                    </div>
                  )}
                </div>
              ))}
            </nav>
          </details>
        )}
        {series && <PostSeriesNav series={series} currentUrl={url} />}
        <slot />
        {hasMermaid && <MermaidRenderer />}
        <CodeCopy />
        {tags.length > 0 && (
          <footer class="article-footer-tags" aria-label="Post tags">
            <span class="aside-label">Tagged with</span>
            <div class="article-tags">
              {tags.map((tag) => <a href={termUrl('tags', tag)}>#{tag}</a>)}
            </div>
          </footer>
        )}
        {post.data.showSocial !== false && <ShareLinks title={post.data.title} url={absoluteUrl} />}
        {post.data.comments !== false && <Disqus identifier={url} title={post.data.title} url={absoluteUrl} />}
      </div>
    </div>
  </article>
</BaseLayout>
